CARVEY_DATA_DIR=./data
TZ=Europe/London
CARVEY_DEBUG_EASTER_EGGS=false
# Set to reset the admin password on next startup, then remove it
# CARVEY_RESET_PASSWORD=
# Set to true to turn off the built-in daily notification check
# CARVEY_DISABLE_SCHEDULER=false
# Sign-in: password (default), proxy or none. See the README for proxy setup.
# CARVEY_AUTH_MODE=password
# CARVEY_PROXY_SECRET=
# CARVEY_PROXY_USER_HEADER=Remote-User
# Set to true to turn off two-factor on next startup, then remove it
# CARVEY_RESET_2FA=
